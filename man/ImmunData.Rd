idata <- get_test_idata() |>
  agg_repertoires(schema = "Response")

idata$repertoires |>
  select(Response, n_barcodes, n_receptors) |>
  arrange(Response)
# Expected result:
#   Response n_barcodes n_receptors
#   FR              955         871
#   PR              947         867

